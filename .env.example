# Copy to .env and adjust. .env is gitignored; this file is not.
# These are local development credentials only — never reuse them anywhere real.

# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB are read by the image only
# while the postgres-data volume is empty. Changing them afterwards has no
# effect on an existing database — see "Resetting the database" in the README.
POSTGRES_USER=devduel
POSTGRES_PASSWORD=devduel
POSTGRES_DB=devduel

# Host port mapping only. Safe to change at any time; takes effect when Compose
# recreates the service. DATABASE_URL below is a separate setting and does not
# follow it, so change the port in both.
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgres://devduel:devduel@localhost:5432/devduel?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Where the api reads the challenge catalog from, relative to where it runs.
# It registers every challenge it finds there at boot.
CHALLENGES_DIR=challenges

# How often the worker looks for matches whose deadline has passed, and how
# many it ends in one pass. The interval is how late a match can be ended.
FINALIZER_INTERVAL=5s
FINALIZER_BATCH=100

# DATABASE_URL is also what the schema tests connect to. They create and drop
# databases of their own next to this one, so the user needs CREATEDB; the
# compose superuser has it.

# The API listens here. Loopback by default in your own .env if you prefer;
# ":8080" accepts from anywhere the host allows.
API_ADDR=:8080

# Marks the session cookie https only. It defaults to true when unset, which
# is the right default everywhere except a laptop: a Secure cookie is not
# stored by a browser talking to http://localhost, so local development would
# silently never stay signed in.
COOKIE_SECURE=false
